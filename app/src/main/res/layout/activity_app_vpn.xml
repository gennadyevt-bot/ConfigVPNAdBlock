<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App VPN"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#32CD32" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите приложения для маршрутизации"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Конфиг для App VPN:"
        android:textSize="13sp"
        android:textColor="#888888" />

    <Spinner
        android:id="@+id/spServer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/domain_input_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"
        app:checkedButton="@id/btnModeInclude">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeInclude"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Через VPN"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:strokeColor="#32CD32" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeExclude"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Обход VPN"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:strokeColor="#32CD32" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:hint="Поиск приложения..."
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:background="@drawable/domain_input_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="16sp"
        android:singleLine="true"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="#32CD32"
        android:drawablePadding="12dp" />

    <Button
        android:id="@+id/btnAddYandexBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Добавить Яндекс Браузер"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1B7A2B" />

    <TextView
        android:id="@+id/tvCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:text="Выбрано: 0"
        android:textColor="#32CD32"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#32CD32"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="16dp"
        android:text="СОХРАНИТЬ"
        android:textColor="#0D0D0D"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#32CD32" />

</LinearLayout>
